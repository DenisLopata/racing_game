; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="1-Racer"
run/main_scene="res://scenes/UI/main_menu.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

ConfigManager="*res://scripts/config/config_manager.gd"
RaceManager="*res://scripts/race/race_manager.gd"
GameSettings="*res://scripts/game_settings.gd"
PlayerProgress="*res://scripts/progression/player_progress.gd"
DamageSystem="*res://scripts/damage/damage_system.gd"
AchievementManager="*res://scripts/progression/achievement_manager.gd"
ChallengeManager="*res://scripts/progression/challenge_manager.gd"
TimeAttackManager="*res://scripts/race/time_attack_manager.gd"
ItemManager="*res://scripts/items/item_manager.gd"
CosmeticsManager="*res://scripts/customization/cosmetics_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

theme/custom="res://assets/themes/game_theme.tres"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
